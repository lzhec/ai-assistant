{
    "name": "ai-agent-extension",
    "displayName": "AI Agent",
    "description": "Локальный AI помощник с панелью в VS Code",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.101.0"
    },
    "activationEvents": [
        "onView:ai-agent-panel"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aiAssistant",
                    "title": "ai agent",
                    "icon": "media/ai-icon.svg"
                }
            ]
        },
        "views": {
            "aiAssistant": [
                {
                    "id": "ai-agent-panel",
                    "name": "ai panel",
                    "icon": "media/ai-icon.svg",
                    "type": "webview"
                }
            ]
        }
    },
    "scripts": {
        "compile": "tsc -p .",
        "postcompile": "copyfiles -u 2 src/agent/** dist/agent/"
    },
    "devDependencies": {
        "@types/node": "^24.0.13",
        "@types/vscode": "^1.101.0",
        "copyfiles": "^2.4.1",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "node-fetch": "^3.3.2"
    }
}