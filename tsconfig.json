{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "outDir": "dist",
        "rootDir": "src",
        "moduleResolution": "node",
        "types": [
            "node"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/agent",
        "node_modules",
        ".vscode-test"
    ]
}